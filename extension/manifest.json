
{
  "manifest_version": 3,
  "name": "Bookmark Sync",
  "version": "1.0.0",
  "description": "Sincronización unidireccional de marcadores entre navegadores Chromium.",
  "permissions": [
    "bookmarks",
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Bookmark Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/neutral-16.png",
      "32": "icons/neutral-32.png",
      "48": "icons/neutral-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/sync-16.png",
    "32": "icons/sync-32.png",
    "48": "icons/sync-48.png",
    "128": "icons/sync-128.png"
  }
}
